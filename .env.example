# =============================================================
# Environment Variables - Salin file ini menjadi .env
# cp .env.example .env
# =============================================================

# Etherscan API Key - untuk verifikasi contract
# Dapatkan di: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Pinata API Key - untuk mengunggah gambar & metadata NFT
# Dapatkan di: https://app.pinata.cloud/keys
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Alamat Kontrak Terdeploy (Otomatis terisi setelah menjalankan deploy.py)
TEBAK_ANGKA_COIN_ADDRESS=
TEBAK_ANGKA_NFT_ADDRESS=
TEBAK_ANGKA_ADDRESS=
